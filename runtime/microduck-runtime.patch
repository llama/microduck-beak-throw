+
+const fn degrees(values: [f64; NUM_JOINTS]) -> [f64; NUM_JOINTS] {
+    let mut radians = [0.0; NUM_JOINTS];
+    let mut i = 0;
+    while i < NUM_JOINTS {
+        radians[i] = values[i] * std::f64::consts::PI / 180.0;
+        i += 1;
+    }
+    radians
