+def flamingo_composite(
+    env: "ManagerBasedRlEnv",
+    stance_sensor_name: str,
+    lifted_sensor_name: str,
+    lifted_joint_indices: list,
+    tuck_overrides: dict,
+    target_height: float,
+    height_std: float = 0.04,
+    tuck_std: float = 0.5,
+    clearance_target: float = 0.03,
+    max_tilt_cos: float = 0.64,   # ≈ 50°
+    min_height: float = 0.07,
+    asset_cfg: SceneEntityCfg = _DEFAULT_ASSET_CFG,
+) -> torch.Tensor:
+    """Main flamingo reward: hard single-support gate × product of Gaussians.
+
+    Gate (hard, state-based — the "what counts" per AGENTS.md): stance foot in
+    contact AND lifted foot NOT in contact AND trunk not fallen. Toe-touching
+    with the "lifted" foot pays zero by construction.
+
+    Product (each ∈ [0,1], collapses on any deficient factor):
+      - clearance: smoothstep of the lifted foot site height up to
+        ``clearance_target`` (bounded per-step → no jackpot; holding higher
+        than the target pays the same, so no incentive for violent lifts).
+      - tuck: Gaussian on the lifted-leg joints vs ``tuck_overrides``
+        (generous std — the exact fold is style, not the skill).
+      - height: Gaussian on trunk z vs ``target_height`` (blocks the
+        "crouch to the floor and hover a foot" exploit).
+
+    Trunk ROLL is deliberately unpriced (see section header): the equilibrium
+    requires leaning toward the stance foot.
+    """
+    asset: Entity = env.scene[asset_cfg.name]
+    gate = (
+        _sensor_has_contact(env, stance_sensor_name)
+        * (1.0 - _sensor_has_contact(env, lifted_sensor_name))
+        * _not_fallen_mask(env, asset, max_tilt_cos, min_height)
+    )
+
+    foot_z = torch.nan_to_num(
+        asset.data.site_pos_w[:, asset_cfg.site_ids[0], 2]
+        - env.scene.terrain.env_origins[:, 2],
+        nan=0.0,
+    )
+    x = (foot_z / clearance_target).clamp(0.0, 1.0)
+    clearance = x * x * (3.0 - 2.0 * x)  # smoothstep, saturates at target
+
+    target = _servo_default_joint_pos(env, asset).clone()
+    for idx, val in tuck_overrides.items():
+        target[:, idx] = val
+    joint_pos = _servo_joint_pos(env, asset)[:, lifted_joint_indices]
+    target = target[:, lifted_joint_indices]
+    tuck_err_sq = ((joint_pos - target) ** 2).mean(dim=-1)
+    tuck = torch.exp(-tuck_err_sq / (tuck_std * tuck_std))
