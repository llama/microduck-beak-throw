+def _sensor_has_contact(env: "ManagerBasedRlEnv", sensor_name: str) -> torch.Tensor:
+    """Float (N,) 1.0 where the named contact sensor reports any contact."""
+    sensor = env.scene.sensors[sensor_name]
+    found = sensor.data.found
+    if found.dim() > 1:
+        found = found.sum(dim=-1)
+    return (torch.nan_to_num(found, nan=0.0) > 0).float()
+
+
+def _not_fallen_mask(
+    env: "ManagerBasedRlEnv",
+    asset: Entity,
+    max_tilt_cos: float,
+    min_height: float,
+) -> torch.Tensor:
+    """Float (N,) 1.0 where trunk is above min_height and tilted less than the
+    ceiling (cos(tilt) > max_tilt_cos). The ceiling is LOOSE on purpose: the
+    balanced flamingo needs 10-25° of lean (measured), so gate at ~50°."""
+    quat = asset.data.root_link_quat_w
+    qx, qy = quat[:, 1], quat[:, 2]
+    upright_cos = torch.nan_to_num(1.0 - 2.0 * (qx * qx + qy * qy), nan=-1.0)
+    z = torch.nan_to_num(
+        asset.data.root_link_pos_w[:, 2] - env.scene.terrain.env_origins[:, 2], nan=0.0
+    )
+    return ((upright_cos > max_tilt_cos) & (z > min_height)).float()
+
