+    _hull_i = 0
+    for g in jaw.geoms:
+        if g.classname and g.classname.name == "collision":
+            if not g.name:
+                g.name = f"head_hull_{_hull_i}_collision"
+                _hull_i += 1
+            g.contype = 4
+            g.conaffinity = 1
+    return spec
