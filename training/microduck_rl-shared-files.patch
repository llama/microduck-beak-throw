+            type=mujoco.mjtGeom.mjGEOM_BOX,
+            pos=list(pos),
+            quat=list(TRAY_LOCAL_QUAT),
+            size=list(half),
+        )
+        g.contype = 2
+        g.conaffinity = 3   # ball (via its contype 2) + floor (conaffinity bit 1)
+        g.condim = 3
+        g.friction = [1.0, 0.005, 0.0001]
+        g.solref = list(TRAY_SOLREF)
+        g.density = 400.0   # light printed plastic — barely moves the head CoM
+        g.rgba = [1.0, 0.72, 0.11, 1.0]  # bill yellow
