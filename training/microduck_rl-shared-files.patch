+    sideways to fling the foot up" exploit by the not-fallen mask."""
+    asset: Entity = env.scene[asset_cfg.name]
+    gate = _sensor_has_contact(env, stance_sensor_name) * _not_fallen_mask(
+        env, asset, max_tilt_cos, min_height
+    )
+    foot_z = torch.nan_to_num(
+        asset.data.site_pos_w[:, asset_cfg.site_ids[0], 2]
+        - env.scene.terrain.env_origins[:, 2],
+        nan=0.0,
+    )
+    x = (foot_z / clearance_target).clamp(0.0, 1.0)
+    return gate * x * x * (3.0 - 2.0 * x)
+
+
+def flamingo_stillness(
+    env: "ManagerBasedRlEnv",
+    stance_sensor_name: str,
+    lifted_sensor_name: str,
+    vel_std: float = 2.0,
+    max_tilt_cos: float = 0.64,
+    min_height: float = 0.07,
+    asset_cfg: SceneEntityCfg = _DEFAULT_ASSET_CFG,
+) -> torch.Tensor:
+    """Nap calm: Gaussian on servo joint-velocity RMS, gated on the full
+    single-support state. Introduced by curriculum AFTER the balance skill
+    exists (weight 0 at start — an attempt-tax active during discovery makes
+    "do nothing" win; see AGENTS.md). Gated on single support so it can never
+    pay for standing frozen on two feet."""
+    asset: Entity = env.scene[asset_cfg.name]
+    gate = (
+        _sensor_has_contact(env, stance_sensor_name)
+        * (1.0 - _sensor_has_contact(env, lifted_sensor_name))
+        * _not_fallen_mask(env, asset, max_tilt_cos, min_height)
+    )
+    jvel = _servo_joint_vel(env, asset)
+    rms = torch.nan_to_num(jvel, nan=0.0).pow(2).mean(dim=-1).sqrt()
+    return gate * torch.exp(-((rms / vel_std) ** 2))
+
+
+def set_flamingo_spawn(
+    env: "ManagerBasedRlEnv",
+    env_ids: torch.Tensor,
+    asset_cfg: SceneEntityCfg = _DEFAULT_ASSET_CFG,
+    flamingo_prob: float = 0.5,
+    flamingo_joint_overrides: Optional[dict] = None,
+    flamingo_joint_noise_std: float = 0.06,
+    roll_range: tuple = (-0.35, -0.10),
+    pitch_max: float = 0.08,
+    standing_tilt_max: float = 0.10,
+    standing_z_min: float = 0.11,
+    standing_z_max: float = 0.12,
+    flamingo_z_min: float = 0.10,
+    flamingo_z_max: float = 0.115,
+):
+    """Reset event: standing HOME spawn or pre-balanced flamingo spawn.
+
+    The flamingo bucket is the reverse curriculum ("learns the start, never
+    the last mile" fix): episodes that BEGIN near the balanced one-foot state
+    give the hold phase on-policy data from step 0. ``roll_range`` is the
+    body-frame roll toward the stance (left, +y) foot — NEGATIVE values lean
+    left in this quaternion convention, matching the measured equilibrium
+    band (−25°…−10°). Standing spawns keep whatever ``reset_robot_joints``
+    set (HOME + its noise).
+    """
+    if env_ids is None or len(env_ids) == 0:
+        return
+    env_ids = env_ids.to(env.device, dtype=torch.int)
+    num = len(env_ids)
+
+    u = torch.rand(num, device=env.device)
+    is_flam = u < flamingo_prob
+
+    yaw = torch.rand(num, device=env.device) * 2 * np.pi - np.pi
+    # Standing: upright ± standing_tilt_max; flamingo: roll in roll_range,
+    # pitch ± pitch_max. Same ZYX intrinsic (yaw*pitch*roll) construction as
+    # set_random_ground_state.
+    roll_stand = (torch.rand(num, device=env.device) * 2 - 1) * standing_tilt_max
+    pitch_stand = (torch.rand(num, device=env.device) * 2 - 1) * standing_tilt_max
+    roll_flam = (
+        torch.rand(num, device=env.device) * (roll_range[1] - roll_range[0])
+        + roll_range[0]
+    )
+    pitch_flam = (torch.rand(num, device=env.device) * 2 - 1) * pitch_max
+    roll = torch.where(is_flam, roll_flam, roll_stand)
+    pitch = torch.where(is_flam, pitch_flam, pitch_stand)
+
+    cy, sy = torch.cos(yaw * 0.5), torch.sin(yaw * 0.5)
+    cp, sp = torch.cos(pitch * 0.5), torch.sin(pitch * 0.5)
+    cr, sr = torch.cos(roll * 0.5), torch.sin(roll * 0.5)
+    qw = cr * cp * cy + sr * sp * sy
+    qx = sr * cp * cy - cr * sp * sy
+    qy_ = cr * sp * cy + sr * cp * sy
+    qz = cr * cp * sy - sr * sp * cy
+    quat = torch.stack([qw, qx, qy_, qz], dim=1)
+
+    z_stand = (
+        torch.rand(num, device=env.device) * (standing_z_max - standing_z_min)
+        + standing_z_min
+    )
+    z_flam = (
+        torch.rand(num, device=env.device) * (flamingo_z_max - flamingo_z_min)
+        + flamingo_z_min
+    )
+    new_z = torch.where(is_flam, z_flam, z_stand)
+
+    env.sim.data.qpos[env_ids, 2] = new_z
+    env.sim.data.qpos[env_ids, 3:7] = quat
+    env.sim.data.qvel[env_ids, :6] = 0.0
+
+    asset: Entity = env.scene[asset_cfg.name]
+    servo_ids = _servo_joint_ids(env, asset)
+    flam_env_ids = env_ids[is_flam]
+    if flamingo_joint_overrides and len(flam_env_ids) > 0:
+        for jnt_idx, angle in flamingo_joint_overrides.items():
+            env.sim.data.qpos[flam_env_ids, 7 + servo_ids[jnt_idx]] = angle
+        if flamingo_joint_noise_std > 0.0:
+            cols = torch.tensor(
+                [7 + j for j in servo_ids], device=env.device, dtype=torch.long
+            )
+            noise = (
+                torch.randn(len(flam_env_ids), len(cols), device=env.device)
+                * flamingo_joint_noise_std
+            )
+            env.sim.data.qpos[flam_env_ids.unsqueeze(1).long(), cols.unsqueeze(0)] += noise
+
+
+# ══════════════════════════════════════════════════════════════════════════════
+# HEADER — flick a ball out of the bill tray (blind open-loop toss)
+#
+# Model: MICRODUCK_TOSS_ROBOT_CFG (bill tray + ball-transparent head hulls —
+# see get_toss_spec in microduck_constants.py). The ball only collides with
+# the tray, floor, trunk and legs; the ONLY way to accelerate it is through
+# the tray, i.e. by moving the bill — the contact masks are the hard gate.
+# Reward machinery reuses the BallKick family (_ball_kick_dir,
+# ball_forward_velocity, ball_speed_overshoot_penalty, ball_pos/vel_in_base).
+# ══════════════════════════════════════════════════════════════════════════════
+
+
+def reset_ball_in_tray(
+    env: ManagerBasedRlEnv,
+    env_ids: torch.Tensor,
+    offset: tuple = (0.0549, 0.0, 0.1082),
+    drop_height: float = 0.018,
+    noise_xyz: float = 0.004,
+    launched_prob: float = 0.0,
+    windup_prob: float = 0.0,
+    windup_omega: tuple = (4.0, 9.0),
+    asset_name: str = "ball",
+):
+    """Place the ball just above the bill tray; store the toss direction.
+
+    ``offset`` is the nominal tray-floor center relative to the trunk root in
+    the robot's yaw frame at HOME (TOSS_TRAY_OFFSET_FROM_ROOT). The ball spawns
+    ``drop_height`` above it and settles into the tray in the first ~0.1 s.
+    Placement DR is intentionally small (``noise_xyz``): the tray interior is
+    only ~40×22 mm — the placement variation that matters on the real robot
+    (operator drops the ball into the tray) is already this scale.
+
+    Reads the robot root from qpos directly (root_link_pos_w lags until the
+    next forward()); register AFTER set_ground_state, like reset_ball_in_front_of_foot.
+    """
+    if env_ids is None or len(env_ids) == 0:
+        return
+    env_ids = env_ids.to(env.device)
+    robot: Entity = env.scene["robot"]
+    ball: Entity = env.scene[asset_name]
+
+    root = env.sim.data.qpos[env_ids][:, robot.indexing.free_joint_q_adr]
+    qw, qx, qy, qz = root[:, 3], root[:, 4], root[:, 5], root[:, 6]
+    yaw = torch.atan2(2.0 * (qw * qz + qx * qy), 1.0 - 2.0 * (qy * qy + qz * qz))
+    cos_y, sin_y = torch.cos(yaw), torch.sin(yaw)
+
+    n = len(env_ids)
+    # Reverse-curriculum bucket (v7 lesson — AGENTS.md "learns the start,
+    # never the last mile"): with prob ``launched_prob`` the episode starts
+    # with the ball ALREADY mid-launch (just past the lip, flying fwd+up,
+    # latch pre-set). These episodes hand the critic on-policy evidence of the
+    # post-launch payoff (roll reward), raising the value of near-launch
+    # states — the pull the hold-attractor's risk valley otherwise blocks.
+    u = torch.rand(n, device=env.device)
+    is_launched = u < launched_prob
+    # Wind-up bucket (throw_v3 postmortem): episodes that start with the head
+    # ALREADY swinging forward — completing the launch is a one-step
+    # continuation, so on-policy launch data flows without needing noise-based
+    # exploration (which at every tested entropy either failed to launch or
+    # stripped the ball). Reverse curriculum at the ACTION level.
+    is_windup = (u >= launched_prob) & (u < launched_prob + windup_prob)
+
+    off = torch.tensor(offset, device=env.device, dtype=torch.float).repeat(n, 1)
+    off[:, 2] += drop_height
+    off += (torch.rand(n, 3, device=env.device) * 2.0 - 1.0) * noise_xyz
+    # launched bucket: ball just past the front lip, slightly above tray level
+    off[is_launched, 0] += 0.05
+    off[is_launched, 2] += 0.03
+    # windup bucket: ball seated ON the tray floor (no drop — the tray is
+    # about to accelerate away from a falling ball)
+    off[is_windup, 2] -= (drop_height - 0.002)
+
+    pose = torch.zeros(n, 7, device=env.device)
+    pose[:, 0] = root[:, 0] + cos_y * off[:, 0] - sin_y * off[:, 1]
+    pose[:, 1] = root[:, 1] + sin_y * off[:, 0] + cos_y * off[:, 1]
+    pose[:, 2] = root[:, 2] + off[:, 2]
+    pose[:, 3] = 1.0
+    ball.write_root_link_pose_to_sim(pose, env_ids)
+    vel = torch.zeros(n, 6, device=env.device)
+    launch_speed = 0.5 + torch.rand(n, device=env.device) * 0.6   # 0.5-1.1 m/s
+    vel[:, 0] = torch.where(is_launched, cos_y * launch_speed, torch.zeros_like(launch_speed))
+    vel[:, 1] = torch.where(is_launched, sin_y * launch_speed, torch.zeros_like(launch_speed))
+    vel[:, 2] = torch.where(is_launched, torch.full_like(launch_speed, 0.25), torch.zeros_like(launch_speed))
+    # windup bucket: head joints get forward angular velocity; the ball rides
+    # the tray, so seed it with the tray's approximate tangential speed
+    # (lever ~5cm from the neck pivot to the head-top tray).
+    omega = windup_omega[0] + torch.rand(n, device=env.device) * (windup_omega[1] - windup_omega[0])
+    tang = 0.05 * omega
+    vel[:, 0] = torch.where(is_windup, cos_y * tang, vel[:, 0])
+    vel[:, 1] = torch.where(is_windup, sin_y * tang, vel[:, 1])
+    ball.write_root_link_velocity_to_sim(vel, env_ids)
+    if windup_prob > 0.0:
+        wu_ids = env_ids[is_windup]
+        if len(wu_ids) > 0:
+            servo_ids = _servo_joint_ids(env, robot)
+            # neck_pitch (servo 5) and head_pitch (servo 6): forward swing.
+            # qvel column = 6 + entity joint index (free joint contributes 6).
+            for srv in (5, 6):
+                env.sim.data.qvel[wu_ids, 6 + servo_ids[srv]] = omega[is_windup]
+
+    toss_dir = _ball_kick_dir(env)
+    toss_dir[env_ids, 0] = cos_y
+    toss_dir[env_ids, 1] = sin_y
+
+    # Latch state: held-bucket episodes start un-latched with the ball held;
+    # launched-bucket episodes start latched (a legitimate launch by
+    # construction — earns roll reward immediately, but NOT the one-time
+    # bonus, which stays reserved for policy-earned launches).
+    latched, was_held = _ball_toss_state(env)
+    latched[env_ids] = False
+    latched[env_ids[is_launched]] = True
+    was_held[env_ids] = True
+    was_held[env_ids[is_launched]] = False
+    env._ball_toss_just_latched[env_ids] = False
+    env._ball_toss_latch_step[env_ids] = -1
+    # launched-bucket episodes measure any distance from their SPAWN point
+    # (the origin-measurement bug fix); they still earn no distance/arc pay
+    # (policy_earned stays False — scaffolding episodes are not achievements).
+    env._ball_toss_launch_xy[env_ids] = pose[:, :2]
+    env._ball_toss_landed[env_ids] = False
+    env._ball_toss_policy_earned[env_ids] = False
+    env._ball_toss_landed_step[env_ids] = -1
+
+
+def ball_held_reward(
+    env: ManagerBasedRlEnv,
+    asset_name: str = "ball",
+    min_rel_height: float = 0.05,
+) -> torch.Tensor:
+    """Binary: 1 while the ball rides ≥ ``min_rel_height`` above the trunk root.
+
+    Exploration aid: random early policies fling the head and drop the ball in
+    the first second, wasting the episode's toss opportunity. A small always-on
+    hold reward makes carrying the ball worth protecting. The head hulls don't
+    collide with the ball (toss model masks), so "high" can only mean "in the
+    tray" — there is no surface to farm this on except the tray itself.
+    Keep the weight SMALL relative to the toss stack: hold-forever must lose
+    to a completed toss (see the header env cfg weight rationale).
+    """
+    robot: Entity = env.scene["robot"]
+    ball: Entity = env.scene[asset_name]
+    rel_z = ball.data.root_link_pos_w[:, 2] - robot.data.root_link_pos_w[:, 2]
+    return (torch.nan_to_num(rel_z, nan=-1.0) > min_rel_height).float()
+
+
+def _ball_toss_state(env: "ManagerBasedRlEnv"):
+    """Per-env toss-latch state, lazily allocated (kick-dir pattern).
+
+    ``latched``: a legitimate launch happened this episode (ball left the held
+    state moving up and forward). ``was_held``: held-state at the previous
+    reward step, for edge detection. Reset by ``reset_ball_in_tray``.
+    """
+    if not hasattr(env, "_ball_toss_latched"):
+        env._ball_toss_latched = torch.zeros(env.num_envs, dtype=torch.bool, device=env.device)
+        env._ball_toss_was_held = torch.ones(env.num_envs, dtype=torch.bool, device=env.device)
+        env._ball_toss_just_latched = torch.zeros(env.num_envs, dtype=torch.bool, device=env.device)
+        env._ball_toss_latch_step = torch.full((env.num_envs,), -1, dtype=torch.long, device=env.device)
+        env._ball_toss_launch_xy = torch.zeros(env.num_envs, 2, device=env.device)
+        env._ball_toss_landed = torch.zeros(env.num_envs, dtype=torch.bool, device=env.device)
+        env._ball_toss_policy_earned = torch.zeros(env.num_envs, dtype=torch.bool, device=env.device)
+        env._ball_toss_landed_step = torch.full((env.num_envs,), -1, dtype=torch.long, device=env.device)
+    return env._ball_toss_latched, env._ball_toss_was_held
+
+
+def ball_forward_velocity_tossed(
+    env: "ManagerBasedRlEnv",
+    asset_name: str = "ball",
+    max_speed: float = 1.2,
+    min_rel_height: float = 0.05,
+    min_launch_vz: float = 0.05,
+    min_launch_fwd: float = 0.1,
+) -> torch.Tensor:
+    """Ball forward velocity, gated on a LAUNCH LATCH — the anti-dump fix.
+
+    The ungated ``ball_forward_velocity`` bred the dump-hack (2026-08-30, run
+    nelovxk5 / viewer repro): the policy tips the ball off the tray in the
+    first 0.3 s and farms forward reward by pushing it with its body — ball
+    never tossed, ``ball_held`` ≈ 0. Per AGENTS.md, what counts as the
+    maneuver must be a hard state gate: here a per-env latch that opens ONLY
+    when the ball exits the held state (rel height ≥ ``min_rel_height`` above
+    the trunk) with upward (vz > ``min_launch_vz``) AND forward
+    (v·toss_dir > ``min_launch_fwd``) velocity — a flick over the lip. A dump
+    exits downward/backward, never latches, and the episode's forward reward
+    stays zero: dumping is economically dead.
+
+    This term OWNS the state update; ``ball_speed_overshoot_tossed`` reads the
+    latch only, and must be registered AFTER this term (dict order).
+    """
+    latched, was_held = _ball_toss_state(env)
+    robot: Entity = env.scene["robot"]
+    ball: Entity = env.scene[asset_name]
+
+    rel_z = ball.data.root_link_pos_w[:, 2] - robot.data.root_link_pos_w[:, 2]
+    held_now = torch.nan_to_num(rel_z, nan=-1.0) > min_rel_height
+
+    vel = torch.nan_to_num(ball.data.root_link_lin_vel_w, nan=0.0)
+    fwd = (vel[:, :2] * _ball_kick_dir(env)).sum(dim=1)
+
+    just_left = was_held & ~held_now
+    good_launch = just_left & (vel[:, 2] > min_launch_vz) & (fwd > min_launch_fwd)
+    env._ball_toss_just_latched = good_launch & ~latched
+    env._ball_toss_latch_step = torch.where(
+        env._ball_toss_just_latched, env.episode_length_buf.long(), env._ball_toss_latch_step
+    )
+    env._ball_toss_launch_xy = torch.where(
+        env._ball_toss_just_latched.unsqueeze(1),
+        ball.data.root_link_pos_w[:, :2],
+        env._ball_toss_launch_xy,
+    )
+    env._ball_toss_policy_earned |= env._ball_toss_just_latched
+    latched |= good_launch
+    was_held.copy_(held_now)
+
+    return fwd.clamp(0.0, max_speed) * latched.float()
+
+
+def ball_speed_overshoot_tossed(
+    env: "ManagerBasedRlEnv",
+    asset_name: str = "ball",
+    target_speed: float = 1.2,
+    max_penalty: float = 5.0,
+) -> torch.Tensor:
+    """Overshoot companion to ``ball_forward_velocity_tossed`` (reads the
+    latch, no state update — register after the forward term)."""
+    latched, _ = _ball_toss_state(env)
+    ball: Entity = env.scene[asset_name]
+    vel_xy = torch.nan_to_num(ball.data.root_link_lin_vel_w[:, :2], nan=0.0)
+    fwd = (vel_xy * _ball_kick_dir(env)).sum(dim=1)
+    return (fwd - target_speed).clamp(0.0, max_penalty) * latched.float()
+
+
+def ball_toss_launch_bonus(env: "ManagerBasedRlEnv") -> torch.Tensor:
+    """One-time discovery bonus: 1.0 on exactly the step the launch latch first
+    sets this episode, 0 otherwise. Register AFTER ball_forward_velocity_tossed
+    (which owns the state update).
+
+    WHY (header v2, run wibozuwz, iters 47-1144): with the latch honest, the
+    only ball gradient left was ball_held at ~0.06% of the episode return —
+    invisible to PPO. The policy converged to "stand nicely, ignore the ball"
+    and never explored a flick. This bonus prices the DISCOVERY itself; the
+    per-step rolling reward then prices doing it well. Once per episode and
+    bounded, so it cannot be farmed (the latch cannot re-fire)."""
+    _ball_toss_state(env)
+    return env._ball_toss_just_latched.float()
+
+
+def ball_rel_height_diag(env: "ManagerBasedRlEnv", asset_name: str = "ball") -> torch.Tensor:
+    """Diagnostic: ball height above the trunk root, clamped to [-1, 1].
+    Logged via a tiny reward weight so wandb shows where the ball actually is
+    in the GPU sim (the header v2-v4 mystery: held-fraction frozen at ~2%
+    across wildly different tray physics — consistent with the ball free-
+    falling THROUGH the tray, i.e. ball-tray contact never occurring)."""
+    robot: Entity = env.scene["robot"]
+    ball: Entity = env.scene[asset_name]
+    rel = ball.data.root_link_pos_w[:, 2] - robot.data.root_link_pos_w[:, 2]
+    return torch.nan_to_num(rel, nan=-1.0).clamp(-1.0, 1.0)
+
+
+def held_ball_forward_shaping(
+    env: "ManagerBasedRlEnv",
+    asset_name: str = "ball",
+    min_rel_height: float = 0.05,
+    max_speed: float = 0.3,
+) -> torch.Tensor:
+    """Discovery bridge: forward ball velocity WHILE HELD, clamped ≥ 0.
+
+    v5 lesson (run header_v5_collisionfix, iters 1800-2200): a converged hold
+    policy is an attractor that actively suppresses the exploration needed to
+    find the flick — Gaussian action noise never flings the ball over the lip
+    forward+up from a policy optimized to prevent exactly that. This term
+    builds the continuous ramp the latch/bonus can't: sweeping the held ball
+    forward pays immediately, bigger sweeps pay more, and a big enough sweep
+    IS a launch (over the front lip with fwd+up velocity → latch → bonus →
+    roll). Inert after release (held gate) and on backward motion (clamp), so
+    it cannot be farmed post-launch; pre-launch rocking is a acceptable
+    stepping stone that the bonus economics then supersede."""
+    robot: Entity = env.scene["robot"]
+    ball: Entity = env.scene[asset_name]
+    rel_z = ball.data.root_link_pos_w[:, 2] - robot.data.root_link_pos_w[:, 2]
+    held = (torch.nan_to_num(rel_z, nan=-1.0) > min_rel_height).float()
+    vel_xy = torch.nan_to_num(ball.data.root_link_lin_vel_w[:, :2], nan=0.0)
+    fwd = (vel_xy * _ball_kick_dir(env)).sum(dim=1)
+    return held * fwd.clamp(0.0, max_speed)
+
+
+def toss_complete_termination(
+    env: "ManagerBasedRlEnv",
+    settle_steps: int = 50,
+) -> torch.Tensor:
+    """Terminate ``settle_steps`` after a successful launch — "trick done".
+
+    THE decisive economics fix (throw_v5 postmortem): with full-length
+    episodes, the standing+held income stream over a surviving episode (~900)
+    dwarfs any launch jackpot, so if throwing ever risks a fall, PPO
+    rationally learns to BRAKE the throw — measured: bonus 0.1 -> 0.003
+    within ten iterations of the latch working. Ending the episode shortly
+    after the throw removes the annuity: post-launch there is nothing left to
+    earn or lose, the fall-risk asymmetry vanishes, and the jackpot plus the
+    brief roll reward is the whole comparison. Registered time_out=True (a
+    completed trick is success, not failure)."""
+    _ball_toss_state(env)
+    now = env.episode_length_buf.long()
+    ls = env._ball_toss_latch_step
+    lands = env._ball_toss_landed_step
+    # primary exit: the thrown ball touched down (plus a short grace so the
+    # terminal-step rewards register); fallback: the post-latch window, for
+    # flights that never register a clean touchdown.
+    landed_done = (lands >= 0) & (now - lands >= 10)
+    window_done = (ls >= 0) & (now - ls >= settle_steps)
+    return landed_done | window_done
+
+
+def ball_upward_velocity_tossed(
+    env: "ManagerBasedRlEnv",
+    asset_name: str = "ball",
+    max_vz: float = 2.0,
+) -> torch.Tensor:
+    """Post-launch UPWARD ball velocity, clamped >= 0, latch-gated.
+
+    Style term (Doug's spec: "up and forward into the air"): the forward
+    reward is z-blind, so a flat pour and a soaring arc earned identically —
+    and the pour is easier. Positive vz exists only during the ascent
+    (~0.2s), so this is bounded and unfarmable by rolling; paired with the
+    forward term the optimum is the up-and-forward arc. Register after
+    ball_forward_velocity_tossed (latch owner)."""
+    _ball_toss_state(env)
+    ball: Entity = env.scene[asset_name]
+    vz = torch.nan_to_num(ball.data.root_link_lin_vel_w[:, 2], nan=0.0)
+    return vz.clamp(0.0, max_vz) * env._ball_toss_policy_earned.float()
+
+
+def ball_landing_distance_bonus(
+    env: "ManagerBasedRlEnv",
+    asset_name: str = "ball",
+    ball_radius: float = 0.012,
+    max_distance: float = 3.0,
+) -> torch.Tensor:
+    """One-time bonus at the thrown ball's FIRST touchdown, proportional to
+    horizontal distance from the launch point (clamped to ``max_distance``).
+
+    Doug's spec: throw as far as possible. Landing distance is the aligned
+    objective — it prices loft, speed and whole-body power through the single
+    number that is the actual goal (max carry from a 0.28m launch wants a
+    ~40-45 deg release, which the policy now discovers rather than us
+    hand-weighting fwd-vs-up). One-shot per episode (landed flag), bounded,
+    fires only for latched (legitimate) throws. Register after the latch
+    owner."""
+    _ball_toss_state(env)
+    latched = env._ball_toss_latched
+    ball: Entity = env.scene[asset_name]
+    z = torch.nan_to_num(ball.data.root_link_pos_w[:, 2], nan=0.0)
+    touching = z < (ball_radius + 0.003)
+    just_landed = latched & touching & ~env._ball_toss_landed
+    env._ball_toss_landed |= just_landed
+    env._ball_toss_landed_step = torch.where(
+        just_landed, env.episode_length_buf.long(), env._ball_toss_landed_step
+    )
+    dist = torch.norm(
+        torch.nan_to_num(ball.data.root_link_pos_w[:, :2], nan=0.0) - env._ball_toss_launch_xy,
+        dim=1,
+    ).clamp(0.0, max_distance)
+    # scaffolding (spawn-launched) episodes record the landing for the
+    # touchdown termination but earn nothing — achievements only.
+    return dist * (just_landed & env._ball_toss_policy_earned).float()
+
+
+# ══════════════════════════════════════════════════════════════════════════════
+# BEAK THROW — physical and cinematic release, direct forward-carry objective
+#
+# The physical robot has a separately commanded mouth servo, but the training
+# articulation and hot-swap policy contract intentionally remain 14-action.
+# The physical task resolves retention and release entirely through contacts.
+# The separate cinematic task uses an explicit pre-release latch at mouth_tip,
+# then hands the ball to ordinary MuJoCo ballistics with the measured grip
+# velocity.  Keeping those paths separate prevents visual tuning from silently
+# changing the hardware-oriented task.
+# ══════════════════════════════════════════════════════════════════════════════
+
+
+def _beak_throw_state(env: "ManagerBasedRlEnv"):
+    if not hasattr(env, "_beak_released"):
+        env._beak_released = torch.zeros(env.num_envs, dtype=torch.bool, device=env.device)
+        env._beak_just_released = torch.zeros(
+            env.num_envs, dtype=torch.bool, device=env.device
+        )
+        env._beak_prev_grip_pos = torch.zeros(env.num_envs, 3, device=env.device)
+        env._beak_grip_vel = torch.zeros(env.num_envs, 3, device=env.device)
+        env._beak_release_pos = torch.zeros(env.num_envs, 3, device=env.device)
+        env._beak_release_vel = torch.zeros(env.num_envs, 3, device=env.device)
+        env._beak_release_step = torch.full(
+            (env.num_envs,), -1, dtype=torch.long, device=env.device
+        )
+        env._beak_landed = torch.zeros(env.num_envs, dtype=torch.bool, device=env.device)
+        env._beak_just_landed = torch.zeros(
+            env.num_envs, dtype=torch.bool, device=env.device
+        )
+        env._beak_landed_step = torch.full(
+            (env.num_envs,), -1, dtype=torch.long, device=env.device
+        )
+        env._beak_predicted_range = torch.zeros(env.num_envs, device=env.device)
+        env._beak_valid_release = torch.zeros(
+            env.num_envs, dtype=torch.bool, device=env.device
+        )
+        env._beak_grip_ok = torch.ones(
+            env.num_envs, dtype=torch.bool, device=env.device
+        )
+    return env._beak_released
+
+
+class PhaseReferenceJointPositionAction(_JointAction):
+    """Residual joint action around an annealed phase-reference trajectory.
+
+    This is an exploration scaffold, not a deployment controller. It makes the
+    initial mean policy execute a real wind-up/snap so PPO receives carry data
+    immediately. The bias fades completely during training; exported ONNX
+    policies therefore contain the learned motion and need no hidden offset.
+    """
+
+    cfg: "PhaseReferenceJointPositionActionCfg"
+
+    def __init__(self, cfg, env: ManagerBasedRlEnv):
+        super().__init__(cfg, env)
+        self._env = env
+        mouth_ids, _ = self._entity.find_joints((cfg.mouth_joint_name,))
+        if len(mouth_ids) != 1:
+            raise ValueError(
+                f"expected exactly one scripted mouth joint {cfg.mouth_joint_name!r}, "
+                f"found {len(mouth_ids)}"
+            )
+        self._mouth_joint_ids = torch.tensor(
+            mouth_ids, dtype=torch.long, device=env.device
+        )
+        self._name_to_target = {name: i for i, name in enumerate(self._target_names)}
+        for pose_name, pose in (("windup_pose", cfg.windup_pose), ("release_pose", cfg.release_pose)):
+            missing = sorted(set(pose) - set(self._name_to_target))
+            if missing:
+                raise ValueError(f"{pose_name} contains unknown action joints: {missing}")
+
+    def _reference_target(self) -> torch.Tensor:
+        home = self._entity.data.default_joint_pos[:, self._target_ids]
+        windup = home.clone()
+        release = home.clone()
+        for name, value in self.cfg.windup_pose.items():
+            windup[:, self._name_to_target[name]] = value
+        for name, value in self.cfg.release_pose.items():
+            release[:, self._name_to_target[name]] = value
+
+        phase = _gp_phase(self._env, self.cfg.command_name)
+        a = (phase / self.cfg.windup_phase).clamp(0.0, 1.0).unsqueeze(1)
+        b = (
+            (phase - self.cfg.windup_phase)
+            / (self.cfg.release_phase - self.cfg.windup_phase)
+        ).clamp(0.0, 1.0).unsqueeze(1)
+        c = (
+            (phase - self.cfg.release_phase)
+            / (self.cfg.recovery_phase - self.cfg.release_phase)
+        ).clamp(0.0, 1.0).unsqueeze(1)
+        target = home + (windup - home) * a
+        target = torch.where(
+            (phase >= self.cfg.windup_phase).unsqueeze(1),
+            windup + (release - windup) * b,
+            target,
+        )
+        target = torch.where(
+            (phase >= self.cfg.release_phase).unsqueeze(1),
+            release + (home - release) * c,
+            target,
+        )
+        return torch.where(
+            (phase >= self.cfg.recovery_phase).unsqueeze(1), home, target
+        )
+
+    def process_actions(self, actions: torch.Tensor):
+        super().process_actions(actions)
+        if self.cfg.max_bias <= 0.0:
+            return
+        step = float(self._env.common_step_counter)
+        if step <= self.cfg.bias_hold_steps:
+            strength = self.cfg.max_bias
+        else:
+            fade = max(float(self.cfg.bias_fade_steps), 1.0)
+            strength = self.cfg.max_bias * max(
+                0.0, 1.0 - (step - self.cfg.bias_hold_steps) / fade
+            )
+        if strength > 0.0:
+            home = self._entity.data.default_joint_pos[:, self._target_ids]
+            self._processed_actions += strength * (self._reference_target() - home)
+
+    def apply_actions(self) -> None:
+        """Apply policy targets and drive the external mouth servo by phase.
+
+        The passive mouth joint is intentionally absent from the policy action
+        vector.  Its separately modeled XL330 receives a position target here;
+        the actuator's firmware loop, torque limit, voltage sag, and command
+        delay move the joint dynamically.  The joint state is never teleported.
+        """
+        super().apply_actions()
+        phase = _gp_phase(self._env, self.cfg.command_name)
+        opening = (
+            (phase - self.cfg.mouth_release_phase)
+            / max(float(self.cfg.mouth_open_duration_phase), 1.0e-6)
+        ).clamp(0.0, 1.0)
+        # Smoothstep avoids an impulse from teleporting the mouth linkage.
+        opening = opening * opening * (3.0 - 2.0 * opening)
+        position = (
+            self.cfg.mouth_hold_position
+            + opening
+            * (self.cfg.mouth_open_position - self.cfg.mouth_hold_position)
+        ).unsqueeze(1)
+        self._entity.set_joint_position_target(
+            position,
+            joint_ids=self._mouth_joint_ids,
+        )
+
+
+@_dataclass(kw_only=True)
+class PhaseReferenceJointPositionActionCfg(_JointPositionActionCfg):
+    class_type: type = PhaseReferenceJointPositionAction
+    command_name: str = "twist"
+    windup_phase: float = 0.25
+    release_phase: float = 0.50
+    recovery_phase: float = 0.78
+    windup_pose: dict[str, float] = None  # type: ignore[assignment]
+    release_pose: dict[str, float] = None  # type: ignore[assignment]
+    max_bias: float = 1.0
+    bias_hold_steps: int = 250 * 24
+    bias_fade_steps: int = 1250 * 24
+    mouth_joint_name: str = "passive_mouth_open"
+    mouth_release_phase: float = 0.38
+    mouth_open_duration_phase: float = 0.04
+    mouth_hold_position: float = math.radians(20.0)
+    mouth_open_position: float = math.radians(30.0)
+
+    def __post_init__(self):
+        super().__post_init__()
+        self.windup_pose = dict(self.windup_pose or {})
+        self.release_pose = dict(self.release_pose or {})
+        if not (0.0 < self.windup_phase < self.release_phase < self.recovery_phase < 1.0):
+            raise ValueError("expected 0 < windup < release < recovery < 1")
+        if not (0.0 <= self.mouth_release_phase < 1.0):
+            raise ValueError("mouth_release_phase must be in [0, 1)")
+        if self.mouth_open_duration_phase <= 0.0:
+            raise ValueError("mouth_open_duration_phase must be positive")
+        if self.mouth_open_position <= self.mouth_hold_position:
+            raise ValueError("mouth_open_position must exceed mouth_hold_position")
+
+    def build(self, env: ManagerBasedRlEnv) -> PhaseReferenceJointPositionAction:
+        return PhaseReferenceJointPositionAction(self, env)
+
+
+class CinematicBeakJointPositionAction(PhaseReferenceJointPositionAction):
+    """Body policy plus a deterministic pre-release ball grip.
+
+    The ball is placed at the configured point inside the visible beak on each
+    physics substep while the mouth is holding it.  At ``latch_release_phase``
+    the last placement gives it the finite-difference velocity of that point;
+    after that instant this class never writes the ball again.  Contacts,
+    gravity, flight and touchdown are consequently normal MuJoCo physics.
+
+    This intentionally cinematic mechanism is isolated from BeakThrow-Flat.
+    It gives an existing 14-action body policy a clean, repeatable prop handoff
+    without adding an action or observation and without pretending to model a
+    particular real gripper.
+    """
+
+    cfg: "CinematicBeakJointPositionActionCfg"
+
+    def __init__(self, cfg, env: ManagerBasedRlEnv):
+        super().__init__(cfg, env)
+        self._ball: Entity = env.scene[cfg.ball_asset_name]
+        site_ids, _ = self._entity.find_sites((cfg.mouth_site_name,))
+        if len(site_ids) != 1:
+            raise ValueError(
+                f"expected exactly one cinematic grip site {cfg.mouth_site_name!r}, "
+                f"found {len(site_ids)}"
+            )
+        self._mouth_site_id = int(site_ids[0])
+        self._grip_local_offset = torch.tensor(
+            cfg.local_grip_offset, dtype=torch.float, device=env.device
+        )
+        _beak_throw_state(env)
+
+    def process_actions(self, actions: torch.Tensor):
+        # This flag must survive all decimation substeps so the reward manager
+        # observes a release exactly once at the end of the environment step.
+        _beak_throw_state(self._env)
+        self._env._beak_just_released.zero_()
+        super().process_actions(actions)
+
+    def apply_actions(self) -> None:
+        super().apply_actions()
+        env = self._env
+        _beak_throw_state(env)
+
+        site_pos = torch.nan_to_num(
+            self._entity.data.site_pos_w[:, self._mouth_site_id, :], nan=0.0
+        )
+        site_quat = torch.nan_to_num(
+            self._entity.data.site_quat_w[:, self._mouth_site_id, :], nan=0.0
+        )
+        local = self._grip_local_offset.to(dtype=site_pos.dtype).expand(
+            env.num_envs, -1
+        )
+        grip_pos = site_pos + quat_apply(site_quat, local)
+        grip_vel = (grip_pos - env._beak_prev_grip_pos) / max(
+            float(env.physics_dt), 1.0e-6
+        )
+        # The first control step after any reset has no valid previous sample.
+        grip_vel = torch.where(
+            (env.episode_length_buf == 0).unsqueeze(1),
+            torch.zeros_like(grip_vel),
+            grip_vel,
+        )
+        grip_vel = torch.nan_to_num(grip_vel, nan=0.0).clamp(
+            -self.cfg.max_release_speed, self.cfg.max_release_speed
+        )
+        env._beak_grip_vel.copy_(grip_vel)
+
+        phase = _gp_phase(env, self.cfg.command_name)
+        unreleased = ~env._beak_released
+        releasing = unreleased & (phase >= self.cfg.latch_release_phase)
+        attached = unreleased
+        attached_ids = attached.nonzero(as_tuple=False).squeeze(-1)
+        if len(attached_ids) > 0:
+            n = len(attached_ids)
+            pose = torch.zeros(n, 7, dtype=grip_pos.dtype, device=env.device)
+            pose[:, :3] = grip_pos[attached_ids]
+            pose[:, 3] = 1.0
+            velocity = torch.zeros(n, 6, dtype=grip_pos.dtype, device=env.device)
+            velocity[:, :3] = grip_vel[attached_ids]
+            self._ball.write_root_link_pose_to_sim(pose, env_ids=attached_ids)
+            self._ball.write_root_link_velocity_to_sim(
+                velocity, env_ids=attached_ids
+            )
+
+        env._beak_just_released |= releasing
+        env._beak_release_pos = torch.where(
+            releasing.unsqueeze(1), grip_pos, env._beak_release_pos
+        )
+        env._beak_release_vel = torch.where(
+            releasing.unsqueeze(1), grip_vel, env._beak_release_vel
+        )
+        env._beak_release_step = torch.where(
+            releasing, env.episode_length_buf.long(), env._beak_release_step
+        )
+        env._beak_valid_release |= releasing
+        env._beak_released |= releasing
+        env._beak_prev_grip_pos.copy_(grip_pos)
+
+
+@_dataclass(kw_only=True)
+class CinematicBeakJointPositionActionCfg(PhaseReferenceJointPositionActionCfg):
+    class_type: type = CinematicBeakJointPositionAction
+    ball_asset_name: str = "ball"
+    mouth_site_name: str = "mouth_tip"
+    local_grip_offset: tuple[float, float, float] = (-0.009, 0.0, -0.0075)
+    latch_release_phase: float = 0.38
+    max_release_speed: float = 12.0
+
+    def __post_init__(self):
+        super().__post_init__()
+        if not (0.0 < self.latch_release_phase < 1.0):
+            raise ValueError("latch_release_phase must be in (0, 1)")
+        if self.mouth_release_phase > self.latch_release_phase:
+            raise ValueError("the mouth must begin opening no later than latch release")
+        if self.max_release_speed <= 0.0:
+            raise ValueError("max_release_speed must be positive")
+
+    def build(self, env: ManagerBasedRlEnv) -> CinematicBeakJointPositionAction:
+        return CinematicBeakJointPositionAction(self, env)
+
+
+def reset_ball_at_beak(
+    env: ManagerBasedRlEnv,
+    env_ids: torch.Tensor,
+    offset: tuple[float, float, float] = (0.0597, 0.0, 0.0971),
+    noise_xyz: float = 0.001,
+    asset_name: str = "ball",
+) -> None:
+    """Reset the free ball inside the partially closed beak.
+
+    ``offset`` is relative to the trunk root in the reset yaw frame.  After
+    this one reset write the ball is never moved kinematically: explicit upper,
+    lower, and tip contacts retain it until the scripted mouth joint opens.
+    """
+    if env_ids is None or len(env_ids) == 0:
+        return
+    env_ids = env_ids.to(env.device)
+    robot: Entity = env.scene["robot"]
+    ball: Entity = env.scene[asset_name]
+    root = env.sim.data.qpos[env_ids][:, robot.indexing.free_joint_q_adr]
+    qw, qx, qy, qz = root[:, 3], root[:, 4], root[:, 5], root[:, 6]
+    yaw = torch.atan2(2.0 * (qw * qz + qx * qy), 1.0 - 2.0 * (qy * qy + qz * qz))
+    cos_y, sin_y = torch.cos(yaw), torch.sin(yaw)
+
+    n = len(env_ids)
+    off = torch.tensor(offset, device=env.device, dtype=torch.float).repeat(n, 1)
+    off += (torch.rand(n, 3, device=env.device) * 2.0 - 1.0) * noise_xyz
+    pose = torch.zeros(n, 7, device=env.device)
+    pose[:, 0] = root[:, 0] + cos_y * off[:, 0] - sin_y * off[:, 1]
+    pose[:, 1] = root[:, 1] + sin_y * off[:, 0] + cos_y * off[:, 1]
+    pose[:, 2] = root[:, 2] + off[:, 2]
+    pose[:, 3] = 1.0
+    ball.write_root_link_pose_to_sim(pose, env_ids)
+    ball.write_root_link_velocity_to_sim(torch.zeros(n, 6, device=env.device), env_ids)
+
+    toss_dir = _ball_kick_dir(env)
+    toss_dir[env_ids, 0] = cos_y
+    toss_dir[env_ids, 1] = sin_y
+
+    _beak_throw_state(env)
+    env._beak_released[env_ids] = False
+    env._beak_just_released[env_ids] = False
+    env._beak_prev_grip_pos[env_ids] = pose[:, :3]
+    env._beak_grip_vel[env_ids] = 0.0
+    env._beak_release_pos[env_ids] = pose[:, :3]
+    env._beak_release_vel[env_ids] = 0.0
+    env._beak_release_step[env_ids] = -1
+    env._beak_landed[env_ids] = False
+    env._beak_just_landed[env_ids] = False
+    env._beak_landed_step[env_ids] = -1
+    env._beak_predicted_range[env_ids] = 0.0
+    env._beak_valid_release[env_ids] = False
+    env._beak_grip_ok[env_ids] = True
+
+
+def _vacuum_forward_range(
+    pos: torch.Tensor,
+    vel: torch.Tensor,
+    forward_dir_xy: torch.Tensor,
+    ball_radius: float,
+    max_range: float,
+    gravity: float = 9.81,
+) -> torch.Tensor:
+    """Differentiable ballistic carry estimate from a candidate release state."""
+    height = (pos[:, 2] - ball_radius).clamp(min=0.0)
+    vz = vel[:, 2]
+    flight_s = (vz + torch.sqrt((vz * vz + 2.0 * gravity * height).clamp(min=0.0))) / gravity
+    fwd = (vel[:, :2] * forward_dir_xy).sum(dim=1).clamp(min=0.0)
+    return (fwd * flight_s.clamp(min=0.0)).clamp(0.0, max_range)
+
+
+def _vacuum_lateral_range(
+    pos: torch.Tensor,
+    vel: torch.Tensor,
+    forward_dir_xy: torch.Tensor,
+    ball_radius: float,
+    max_range: float,
+    gravity: float = 9.81,
+) -> torch.Tensor:
+    """Differentiable absolute sideways carry from a candidate release state."""
+    height = (pos[:, 2] - ball_radius).clamp(min=0.0)
+    vz = vel[:, 2]
+    flight_s = (
+        vz + torch.sqrt((vz * vz + 2.0 * gravity * height).clamp(min=0.0))
+    ) / gravity
+    lateral_dir_xy = torch.stack(
+        (-forward_dir_xy[:, 1], forward_dir_xy[:, 0]), dim=1
+    )
+    lateral = torch.abs((vel[:, :2] * lateral_dir_xy).sum(dim=1))
+    return (lateral * flight_s.clamp(min=0.0)).clamp(0.0, max_range)
+
+
+def beak_grip_predicted_range(
+    env: "ManagerBasedRlEnv",
+    asset_name: str = "ball",
+    command_name: str = "twist",
+    release_phase: float = 0.50,
+    release_settle_phase: float = 0.16,
+    shaping_start_phase: float = 0.30,
+    local_grip_offset: tuple[float, float, float] = (-0.009, 0.0, -0.0075),
+    max_hold_error: float = 0.020,
+    release_distance: float = 0.020,
+    ball_radius: float = 0.012,
+    max_range: float = 3.0,
+    max_release_tilt_deg: float = 50.0,
+    min_grip_height: float = 0.15,
+    asset_cfg: SceneEntityCfg = SceneEntityCfg(
+        "robot", site_names=("mouth_tip",)
+    ),
+) -> torch.Tensor:
+    """Physical-grip state owner plus dense ballistic-range shaping.
+
+    Register this before every other beak reward.  The ball pose and velocity
+    are read directly from simulation; this function never writes either one.
+    The mouth begins opening at ``release_phase``.  Release is captured from
+    actual physical separation (ball-to-pocket distance), not from the clock.
+    ``release_settle_phase`` is only a deadline: if the ball is still trapped
+    then, the attempt is closed out as invalid so a stuck ball cannot earn a
+    virtual throw.  A ball that escaped before opening is invalid as well.
+    """
+    _beak_throw_state(env)
+    robot: Entity = env.scene[asset_cfg.name]
+    ball: Entity = env.scene[asset_name]
+    sid = int(asset_cfg.site_ids[0])
+    site_pos = torch.nan_to_num(robot.data.site_pos_w[:, sid, :], nan=0.0)
+    site_quat = torch.nan_to_num(robot.data.site_quat_w[:, sid, :], nan=0.0)
+    local = torch.tensor(local_grip_offset, device=env.device, dtype=site_pos.dtype)
+    grip_pos = site_pos + quat_apply(site_quat, local.expand(env.num_envs, -1))
+    ball_pos = torch.nan_to_num(ball.data.root_link_pos_w, nan=0.0)
+    ball_vel = torch.nan_to_num(ball.data.root_link_lin_vel_w, nan=0.0).clamp(-10.0, 10.0)
+    env._beak_grip_vel.copy_(ball_vel)
+
+    phase = _gp_phase(env, command_name)
+    unreleased = ~env._beak_released
+    grip_error = torch.linalg.vector_norm(ball_pos - grip_pos, dim=1)
+    before_open = unreleased & (phase < release_phase)
+    env._beak_grip_ok &= ~(before_open & (grip_error > max_hold_error))
+    mouth_commanded_open = phase >= release_phase
+    physically_separated = grip_error > release_distance
+    release_deadline = phase >= release_phase + release_settle_phase
+    stuck_at_deadline = unreleased & release_deadline & ~physically_separated
+    env._beak_grip_ok &= ~stuck_at_deadline
+    releasing = unreleased & mouth_commanded_open & (
+        physically_separated | release_deadline
+    )
+
+    env._beak_just_released.copy_(releasing)
+    env._beak_release_pos = torch.where(
+        releasing.unsqueeze(1), ball_pos, env._beak_release_pos
+    )
+    env._beak_release_vel = torch.where(
+        releasing.unsqueeze(1), ball_vel, env._beak_release_vel
+    )
+    env._beak_release_step = torch.where(
+        releasing, env.episode_length_buf.long(), env._beak_release_step
+    )
+    env._beak_released |= releasing
+    env._beak_prev_grip_pos.copy_(grip_pos)
+
+    quat = robot.data.root_link_quat_w
+    cos_tilt = torch.nan_to_num(
+        1.0 - 2.0 * (quat[:, 1] ** 2 + quat[:, 2] ** 2), nan=-1.0
+    )
+    rel_height = ball_pos[:, 2] - env.scene.terrain.env_origins[:, 2]
+    valid_pose = (cos_tilt > math.cos(math.radians(max_release_tilt_deg))) & (
+        rel_height > min_grip_height
+    ) & env._beak_grip_ok
+    env._beak_valid_release = torch.where(
+        releasing, valid_pose, env._beak_valid_release
+    )
+
+    predicted = _vacuum_forward_range(
+        ball_pos, ball_vel, _ball_kick_dir(env), ball_radius, max_range
+    )
+    env._beak_predicted_range.copy_(predicted)
+    in_window = (
+        (phase >= shaping_start_phase)
+        & (phase <= release_phase + release_settle_phase)
+        & ~env._beak_released
+    )
+    return predicted * in_window.float() * valid_pose.float()
+
+
+def cinematic_beak_predicted_range(
+    env: "ManagerBasedRlEnv",
+    command_name: str = "twist",
+    release_phase: float = 0.38,
+    shaping_start_phase: float = 0.28,
+    ball_radius: float = 0.012,
+    max_range: float = 3.0,
+) -> torch.Tensor:
+    """Dense range estimate for the cinematic latch/release action.
+
+    The action term owns the state transition.  This reward only reads the
+    measured grip velocity before release and the captured release state after
+    release, avoiding a second and potentially contradictory release detector.
+    Register it before the one-shot release rewards so ``_beak_predicted_range``
+    is current when they run.
+    """
+    _beak_throw_state(env)
+    ball: Entity = env.scene["ball"]
+    phase = _gp_phase(env, command_name)
+    pos = torch.where(
+        env._beak_released.unsqueeze(1),
+        env._beak_release_pos,
+        torch.nan_to_num(ball.data.root_link_pos_w, nan=0.0),
+    )
+    vel = torch.where(
+        env._beak_released.unsqueeze(1),
+        env._beak_release_vel,
+        env._beak_grip_vel,
+    )
+    predicted = _vacuum_forward_range(
+        pos, vel, _ball_kick_dir(env), ball_radius, max_range
+    )
+    env._beak_predicted_range.copy_(predicted)
+    in_window = (
+        (phase >= shaping_start_phase)
+        & (phase <= release_phase)
+        & ~env._beak_released
+    )
+    return predicted * in_window.float()
+
+
+def beak_release_range_bonus(env: "ManagerBasedRlEnv") -> torch.Tensor:
+    """One-time ballistic-range estimate at the scripted mouth-open instant."""
+    _beak_throw_state(env)
+    return (
+        env._beak_predicted_range
+        * env._beak_just_released.float()
+        * env._beak_valid_release.float()
+    )
+
+
+def beak_release_forward_velocity(env: "ManagerBasedRlEnv", max_speed: float = 5.0) -> torch.Tensor:
+    """Diagnostic/shaping channel: forward release speed, one-time."""
+    _beak_throw_state(env)
+    fwd = (env._beak_release_vel[:, :2] * _ball_kick_dir(env)).sum(dim=1)
+    return (
+        fwd.clamp(0.0, max_speed)
+        * env._beak_just_released.float()
+        * env._beak_valid_release.float()
+    )
+
+
+def beak_release_upward_velocity(env: "ManagerBasedRlEnv", max_speed: float = 5.0) -> torch.Tensor:
+    """Diagnostic channel: upward release speed, one-time."""
+    _beak_throw_state(env)
+    return (
+        env._beak_release_vel[:, 2].clamp(0.0, max_speed)
+        * env._beak_just_released.float()
+        * env._beak_valid_release.float()
+    )
+
+
+def beak_grip_predicted_lateral_range(
+    env: "ManagerBasedRlEnv",
+    asset_name: str = "ball",
+    command_name: str = "twist",
+    release_phase: float = 0.30,
+    release_settle_phase: float = 0.16,
+    shaping_start_phase: float = 0.24,
+    ball_radius: float = 0.012,
+    max_range: float = 1.0,
+) -> torch.Tensor:
+    """Dense body-heading-relative sideways-flight cost before release.
+
+    The landing miss is delayed by the full ballistic flight and gave PPO weak
+    credit for which pre-release action caused it.  This term prices the
+    candidate lateral carry every control step around the snap, using the same
+    ballistic time-of-flight model as the forward-range reward.  It is zero
+    after release; the one-shot release and touchdown terms own those states.
+    """
+    _beak_throw_state(env)
+    ball: Entity = env.scene[asset_name]
+    phase = _gp_phase(env, command_name)
+    pos = torch.nan_to_num(ball.data.root_link_pos_w, nan=0.0)
+    vel = torch.nan_to_num(ball.data.root_link_lin_vel_w, nan=0.0).clamp(-10.0, 10.0)
+    predicted = _vacuum_lateral_range(
+        pos,
+        vel,
+        _ball_kick_dir(env),
+        ball_radius,
+        max_range,
+    )
+    in_window = (
+        (phase >= shaping_start_phase)
+        & (phase <= release_phase + release_settle_phase)
+        & ~env._beak_released
+        & env._beak_grip_ok
+    )
+    return predicted * in_window.float()
+
+
+def beak_release_lateral_velocity(
+    env: "ManagerBasedRlEnv", max_speed: float = 5.0
+) -> torch.Tensor:
+    """Absolute body-heading-relative sideways speed, paid once at release."""
+    _beak_throw_state(env)
+    forward = _ball_kick_dir(env)
+    lateral_axis = torch.stack((-forward[:, 1], forward[:, 0]), dim=1)
+    lateral = torch.abs((env._beak_release_vel[:, :2] * lateral_axis).sum(dim=1))
+    return (
+        lateral.clamp(0.0, max_speed)
+        * env._beak_just_released.float()
+        * env._beak_valid_release.float()
+    )
+
+
+def beak_landing_forward_distance(
+    env: "ManagerBasedRlEnv",
+    asset_name: str = "ball",
+    ball_radius: float = 0.012,
+    max_distance: float = 3.0,
+) -> torch.Tensor:
+    """Actual forward carry from release to first touchdown, paid once.
+
+    Unlike the retired Header distance term, this projects onto the reset
+    heading. Sideways or backward displacement cannot masquerade as distance.
+    """
+    _beak_throw_state(env)
+    ball: Entity = env.scene[asset_name]
+    z = torch.nan_to_num(ball.data.root_link_pos_w[:, 2], nan=0.0)
+    touching = z < (ball_radius + 0.003)
+    just_landed = env._beak_released & touching & ~env._beak_landed
+    env._beak_just_landed.copy_(just_landed)
+    env._beak_landed |= just_landed
+    env._beak_landed_step = torch.where(
+        just_landed, env.episode_length_buf.long(), env._beak_landed_step
+    )
+    delta_xy = torch.nan_to_num(ball.data.root_link_pos_w[:, :2], nan=0.0) - env._beak_release_pos[:, :2]
+    forward = (delta_xy * _ball_kick_dir(env)).sum(dim=1).clamp(0.0, max_distance)
+    return forward * just_landed.float() * env._beak_valid_release.float()
+
+
+def beak_landing_lateral_distance(
+    env: "ManagerBasedRlEnv",
+    asset_name: str = "ball",
+    max_distance: float = 1.0,
+) -> torch.Tensor:
+    """Absolute sideways miss at first touchdown, paid once.
+
+    This must be registered after :func:`beak_landing_forward_distance`, which
+    owns the touchdown transition and sets ``_beak_just_landed``.
+    """
+    _beak_throw_state(env)
+    ball: Entity = env.scene[asset_name]
+    delta_xy = (
+        torch.nan_to_num(ball.data.root_link_pos_w[:, :2], nan=0.0)
+        - env._beak_release_pos[:, :2]
+    )
+    forward = _ball_kick_dir(env)
+    lateral_axis = torch.stack((-forward[:, 1], forward[:, 0]), dim=1)
+    lateral = torch.abs((delta_xy * lateral_axis).sum(dim=1)).clamp(
+        0.0, max_distance
+    )
+    return (
+        lateral
+        * env._beak_just_landed.float()
+        * env._beak_valid_release.float()
+    )
+
+
+def beak_recovery_upright_linear(
+    env: "ManagerBasedRlEnv",
+    command_name: str = "twist",
+    start_phase: float = 0.45,
+    full_phase: float = 0.70,
+    asset_cfg: SceneEntityCfg = _DEFAULT_ASSET_CFG,
+) -> torch.Tensor:
+    """Linear upright signal that turns on only after the throwing snap.
+
+    The ordinary upright Gaussian has almost no gradient once the duck is near
+    horizontal, which let the hardware continuation buy distance by falling
+    after release.  ``cos(tilt)`` remains informative through a fall and becomes
+    negative when inverted.  A smooth phase gate leaves the wind-up/snap free,
+    then requires recovery before robotd's phase-1 handoff to the stand policy.
+    """
+    if not 0.0 <= start_phase < full_phase <= 1.0:
+        raise ValueError("expected 0 <= start_phase < full_phase <= 1")
+    phase = _gp_phase(env, command_name)
+    gate = ((phase - start_phase) / (full_phase - start_phase)).clamp(0.0, 1.0)
+    gate = gate * gate * (3.0 - 2.0 * gate)
+    asset: Entity = env.scene[asset_cfg.name]
+    quat = asset.data.root_link_quat_w
+    upright = 1.0 - 2.0 * (quat[:, 1].square() + quat[:, 2].square())
+    return gate * upright
+
+
+def beak_throw_complete_termination(
+    env: "ManagerBasedRlEnv",
+    landing_grace_steps: int = 2,
+    post_release_steps: int = 100,
+) -> torch.Tensor:
+    """End after touchdown, with a timeout fallback for very long flights."""
+    _beak_throw_state(env)
+    now = env.episode_length_buf.long()
+    landed = (env._beak_landed_step >= 0) & (
+        now - env._beak_landed_step >= landing_grace_steps
+    )
+    released = (env._beak_release_step >= 0) & (
+        now - env._beak_release_step >= post_release_steps
+    )
+    return landed | released
+
+
+def beak_reference_pose_track(
+    env: "ManagerBasedRlEnv",
+    command_name: str = "twist",
+    windup_phase: float = 0.25,
+    release_phase: float = 0.50,
+    recovery_phase: float = 0.78,
+    windup_pose: dict[str, float] | None = None,
+    release_pose: dict[str, float] | None = None,
+    joint_indices: tuple[int, ...] = (5, 6),
+    std: float = 0.35,
+    asset_cfg: SceneEntityCfg = _DEFAULT_ASSET_CFG,
+) -> torch.Tensor:
+    """Loose phase reference for bootstrap: HOME→wind-up→snap→HOME.
+
+    Only the selected servo-view joints are tracked (neck/head by default), so
+    the legs remain free to discover a crouch, jump, or recoil strategy. The
+    reward is intended to decay by curriculum after releases become reliable.
+    """
+    if not (0.0 < windup_phase < release_phase < recovery_phase < 1.0):
+        raise ValueError("expected 0 < windup < release < recovery < 1")
+    windup_pose = windup_pose or {}
+    release_pose = release_pose or {}
+    asset: Entity = env.scene[asset_cfg.name]
+    servo_ids = _servo_joint_ids(env, asset)
+    names = [asset.joint_names[i] for i in servo_ids]
+    home = _servo_default_joint_pos(env, asset)
+    windup = home.clone()
+    release = home.clone()
+    for name, value in windup_pose.items():
+        if name not in names:
+            raise ValueError(f"unknown servo joint in windup_pose: {name}")
+        windup[:, names.index(name)] = value
+    for name, value in release_pose.items():
+        if name not in names:
+            raise ValueError(f"unknown servo joint in release_pose: {name}")
+        release[:, names.index(name)] = value
+
+    phase = _gp_phase(env, command_name)
+    a = (phase / windup_phase).clamp(0.0, 1.0).unsqueeze(1)
+    b = ((phase - windup_phase) / (release_phase - windup_phase)).clamp(0.0, 1.0).unsqueeze(1)
+    c = ((phase - release_phase) / (recovery_phase - release_phase)).clamp(0.0, 1.0).unsqueeze(1)
+    target = home + (windup - home) * a
+    target = torch.where((phase >= windup_phase).unsqueeze(1), windup + (release - windup) * b, target)
+    target = torch.where((phase >= release_phase).unsqueeze(1), release + (home - release) * c, target)
+    target = torch.where((phase >= recovery_phase).unsqueeze(1), home, target)
+
+    ids = list(joint_indices)
+    current = _servo_joint_pos(env, asset)[:, ids]
+    error = current - target[:, ids]
+    return torch.exp(-torch.mean((error / std) ** 2, dim=1))
