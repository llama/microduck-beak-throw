+def _make_head_ball_transparent(spec: mujoco.MjSpec) -> mujoco.MjSpec:
+    """Let a contype-2 prop pass through convex head collision hulls.
+
+    The exported head meshes are convexified by MuJoCo, so the visual mouth
+    cavity is solid in collision space.  Both the physical tray task and the
+    phase-controlled beak task need the small ball to ignore those hulls while
+    the head must still collide with the floor and body.
+    """
