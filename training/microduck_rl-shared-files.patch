+class MicroduckCinematicOnPolicyRunner(MicroduckOnPolicyRunner):
+    """Conservative model_1250 continuation runner for the cinematic task.
+
+    A normal resume restores the old optimizer's 1e-3 learning rate and the
+    actor's roughly 0.4 action std, silently defeating the gentler cinematic
+    config.  This runner restores the networks and iteration counter but starts
+    a fresh optimizer at the configured 2e-4 and clamps exploration to 0.18.
+    It also disables random episode-age initialization because a throw is a
+    phase-locked one-shot sequence that must begin before release.
+    """
+
+    def load(self, path, load_cfg=None, strict=True, map_location=None):
+        if load_cfg is None:
+            load_cfg = {
+                "actor": True,
+                "critic": True,
+                "optimizer": False,
+                "iteration": True,
+                "rnd": False,
+            }
+        infos = super().load(path, load_cfg, strict, map_location)
+        distribution = self.alg.actor.distribution
+        if hasattr(distribution, "std_param"):
+            distribution.std_param.data.fill_(0.18)
+        elif hasattr(distribution, "log_std_param"):
+            import math
+
+            distribution.log_std_param.data.fill_(math.log(0.18))
+        return infos
+
+    def learn(self, num_learning_iterations, init_at_random_ep_len=False):
+        return super().learn(
+            num_learning_iterations,
+            init_at_random_ep_len=False,
+        )
+
+
+class MicroduckHardwareOnPolicyRunner(MicroduckOnPolicyRunner):
